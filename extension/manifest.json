{
  "manifest_version": 3,
  "name": "Inbox Translator for Fiverr",
  "version": "1.1.0",
  "description": "Translate Fiverr conversations and draft replies with your own OpenAI API key. Local translation cache.",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Inbox Translator",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.fiverr.com/*",
        "https://fiverr.com/*"
      ],
      "js": [
        "languages.js",
        "i18n.js",
        "inbox-adapter.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}